<Project Sdk="Microsoft.NET.Sdk.Web">

  <PropertyGroup>
    <TargetFramework>net8.0</TargetFramework>
    <Nullable>enable</Nullable>
    <ImplicitUsings>enable</ImplicitUsings>
  </PropertyGroup>

  <!-- Веб-клиент (PWA) из папки docs попадает в сборку сервера как wwwroot
       и раздаётся по адресу /app -->
  <ItemGroup>
    <Content Include="..\docs\**" LinkBase="wwwroot" CopyToOutputDirectory="PreserveNewest" />
  </ItemGroup>

</Project>
