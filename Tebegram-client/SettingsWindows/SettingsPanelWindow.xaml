<Window
    x:Class="Tebegrammmm.SettingsPanelWindow"
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
    xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
    xmlns:local1="clr-namespace:Tebegrammmm.Controls"
    xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
    Title="Настройки"
    Width="400"
    SizeToContent="Height"
    AllowsTransparency="True"
    Background="Transparent"
    MouseDown="Window_MouseDown"
    WindowStartupLocation="CenterScreen"
    WindowStyle="None"
    mc:Ignorable="d">

    <Window.Resources>

        <ControlTemplate x:Key="CloseButtonTemplate" TargetType="Button">
            <Border x:Name="Bd" Background="Transparent" CornerRadius="6">
                <TextBlock
                    x:Name="Txt"
                    HorizontalAlignment="Center"
                    VerticalAlignment="Center"
                    FontSize="{TemplateBinding FontSize}"
                    Foreground="{DynamicResource Light.TextMutedBrush}"
                    Text="{TemplateBinding Content}" />
            </Border>
            <ControlTemplate.Triggers>
                <Trigger Property="IsMouseOver" Value="True">
                    <Setter TargetName="Bd" Property="Background" Value="{DynamicResource Light.DangerBrush}" />
                    <Setter TargetName="Txt" Property="Foreground" Value="White" />
                </Trigger>
                <Trigger Property="IsPressed" Value="True">
                    <Setter TargetName="Bd" Property="Background" Value="{DynamicResource Light.DangerHoverBrush}" />
                </Trigger>
            </ControlTemplate.Triggers>
        </ControlTemplate>

        <ControlTemplate x:Key="MinimizeButtonTemplate" TargetType="Button">
            <Border x:Name="Bd" Background="Transparent" CornerRadius="6">
                <TextBlock
                    x:Name="Txt"
                    HorizontalAlignment="Center"
                    VerticalAlignment="Center"
                    FontSize="{TemplateBinding FontSize}"
                    Foreground="{DynamicResource Light.TextMutedBrush}"
                    Text="{TemplateBinding Content}" />
            </Border>
            <ControlTemplate.Triggers>
                <Trigger Property="IsMouseOver" Value="True">
                    <Setter TargetName="Bd" Property="Background" Value="{DynamicResource Light.BgElevatedBrush}" />
                    <Setter TargetName="Txt" Property="Foreground" Value="{DynamicResource Light.TextPrimaryBrush}" />
                </Trigger>
                <Trigger Property="IsPressed" Value="True">
                    <Setter TargetName="Bd" Property="Background" Value="{DynamicResource Light.BgDeepBrush}" />
                </Trigger>
            </ControlTemplate.Triggers>
        </ControlTemplate>

        <!--  «Тихая» текстовая кнопка (ссылка)  -->
        <ControlTemplate x:Key="GhostButtonTemplate" TargetType="Button">
            <Border
                x:Name="Bd"
                Padding="8,5"
                Background="Transparent"
                CornerRadius="8">
                <ContentPresenter HorizontalAlignment="Center" VerticalAlignment="Center" />
            </Border>
            <ControlTemplate.Triggers>
                <Trigger Property="IsMouseOver" Value="True">
                    <Setter TargetName="Bd" Property="Background" Value="{DynamicResource Light.AccentMutedBrush}" />
                </Trigger>
                <Trigger Property="IsPressed" Value="True">
                    <Setter TargetName="Bd" Property="Opacity" Value="0.7" />
                </Trigger>
            </ControlTemplate.Triggers>
        </ControlTemplate>

        <!--  Переключатель-тумблер (iOS-стиль)  -->
        <ControlTemplate x:Key="ToggleSwitchTemplate" TargetType="ToggleButton">
            <Border
                x:Name="Track"
                Width="46"
                Height="26"
                Background="{DynamicResource Light.BorderStrongBrush}"
                CornerRadius="13">
                <Ellipse
                    x:Name="Thumb"
                    Width="20"
                    Height="20"
                    Margin="3,0,0,0"
                    HorizontalAlignment="Left"
                    Fill="White">
                    <Ellipse.RenderTransform>
                        <TranslateTransform x:Name="ThumbShift" X="0" />
                    </Ellipse.RenderTransform>
                </Ellipse>
            </Border>
            <ControlTemplate.Triggers>
                <Trigger Property="IsChecked" Value="True">
                    <Setter TargetName="Track" Property="Background" Value="{DynamicResource Light.AccentPrimaryBrush}" />
                    <Trigger.EnterActions>
                        <BeginStoryboard>
                            <Storyboard>
                                <DoubleAnimation
                                    Storyboard.TargetName="ThumbShift"
                                    Storyboard.TargetProperty="X"
                                    To="20"
                                    Duration="0:0:0.18">
                                    <DoubleAnimation.EasingFunction>
                                        <CubicEase EasingMode="EaseOut" />
                                    </DoubleAnimation.EasingFunction>
                                </DoubleAnimation>
                            </Storyboard>
                        </BeginStoryboard>
                    </Trigger.EnterActions>
                    <Trigger.ExitActions>
                        <BeginStoryboard>
                            <Storyboard>
                                <DoubleAnimation
                                    Storyboard.TargetName="ThumbShift"
                                    Storyboard.TargetProperty="X"
                                    To="0"
                                    Duration="0:0:0.18">
                                    <DoubleAnimation.EasingFunction>
                                        <CubicEase EasingMode="EaseOut" />
                                    </DoubleAnimation.EasingFunction>
                                </DoubleAnimation>
                            </Storyboard>
                        </BeginStoryboard>
                    </Trigger.ExitActions>
                </Trigger>
            </ControlTemplate.Triggers>
        </ControlTemplate>

        <!--  ComboBox: контейнер элемента (скруглённый, в теме)  -->
        <Style x:Key="DeviceComboBoxItemStyle" TargetType="ComboBoxItem">
            <Setter Property="Background" Value="Transparent" />
            <Setter Property="Foreground" Value="{DynamicResource Light.TextPrimaryBrush}" />
            <Setter Property="FontSize" Value="13" />
            <Setter Property="Padding" Value="12,9" />
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="ComboBoxItem">
                        <Border
                            x:Name="ItemBd"
                            Margin="4,2"
                            Padding="{TemplateBinding Padding}"
                            Background="{TemplateBinding Background}"
                            CornerRadius="8">
                            <ContentPresenter />
                        </Border>
                        <ControlTemplate.Triggers>
                            <Trigger Property="IsMouseOver" Value="True">
                                <Setter TargetName="ItemBd" Property="Background" Value="{DynamicResource Light.BgElevatedBrush}" />
                            </Trigger>
                            <Trigger Property="IsSelected" Value="True">
                                <Setter TargetName="ItemBd" Property="Background" Value="{DynamicResource Light.AccentMutedBrush}" />
                                <Setter Property="Foreground" Value="{DynamicResource Light.AccentTextBrush}" />
                            </Trigger>
                        </ControlTemplate.Triggers>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>

        <!--  ComboBox: основной шаблон (скруглённый, с плавным выпадающим списком)  -->
        <ControlTemplate x:Key="DeviceComboBoxTemplate" TargetType="ComboBox">
            <Grid>
                <Border
                    x:Name="Bd"
                    Height="42"
                    Background="{DynamicResource Light.BgInputBrush}"
                    BorderBrush="{DynamicResource Light.BorderDefaultBrush}"
                    BorderThickness="1"
                    CornerRadius="10">
                    <Grid Margin="14,0,12,0">
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition />
                            <ColumnDefinition Width="20" />
                        </Grid.ColumnDefinitions>
                        <ContentPresenter
                            VerticalAlignment="Center"
                            Content="{TemplateBinding SelectionBoxItem}"
                            ContentStringFormat="{TemplateBinding SelectionBoxItemStringFormat}"
                            ContentTemplate="{TemplateBinding SelectionBoxItemTemplate}"
                            IsHitTestVisible="False"
                            TextBlock.FontSize="13"
                            TextBlock.Foreground="{DynamicResource Light.TextPrimaryBrush}" />
                        <Path
                            x:Name="Arrow"
                            Grid.Column="1"
                            HorizontalAlignment="Center"
                            VerticalAlignment="Center"
                            Data="M0,0 L4,5 L8,0"
                            Fill="Transparent"
                            Stroke="{DynamicResource Light.TextMutedBrush}"
                            StrokeEndLineCap="Round"
                            StrokeLineJoin="Round"
                            StrokeStartLineCap="Round"
                            StrokeThickness="1.5" />
                    </Grid>
                </Border>
                <ToggleButton
                    Background="Transparent"
                    BorderThickness="0"
                    ClickMode="Press"
                    Focusable="False"
                    IsChecked="{Binding IsDropDownOpen, Mode=TwoWay, RelativeSource={RelativeSource TemplatedParent}}">
                    <ToggleButton.Template>
                        <ControlTemplate TargetType="ToggleButton">
                            <Border Background="Transparent" />
                        </ControlTemplate>
                    </ToggleButton.Template>
                </ToggleButton>
                <Popup
                    x:Name="PART_Popup"
                    AllowsTransparency="True"
                    Focusable="False"
                    IsOpen="{TemplateBinding IsDropDownOpen}"
                    Placement="Bottom"
                    PopupAnimation="Slide">
                    <Border
                        MinWidth="{TemplateBinding ActualWidth}"
                        MaxHeight="200"
                        Margin="0,4,0,0"
                        Padding="0,4"
                        Background="{DynamicResource Light.BgSurfaceBrush}"
                        BorderBrush="{DynamicResource Light.BorderDefaultBrush}"
                        BorderThickness="1"
                        CornerRadius="10">
                        <Border.Effect>
                            <DropShadowEffect BlurRadius="16" Opacity="0.1" ShadowDepth="4" Color="#000000" />
                        </Border.Effect>
                        <ScrollViewer HorizontalScrollBarVisibility="Disabled">
                            <ItemsPresenter />
                        </ScrollViewer>
                    </Border>
                </Popup>
            </Grid>
            <ControlTemplate.Triggers>
                <Trigger Property="IsMouseOver" Value="True">
                    <Setter TargetName="Bd" Property="BorderBrush" Value="{DynamicResource Light.BorderStrongBrush}" />
                </Trigger>
                <Trigger Property="IsDropDownOpen" Value="True">
                    <Setter TargetName="Bd" Property="BorderBrush" Value="{DynamicResource Light.BorderFocusBrush}" />
                </Trigger>
            </ControlTemplate.Triggers>
        </ControlTemplate>

        <!--  Кнопка выхода: outline красная  -->
        <ControlTemplate x:Key="DangerButtonTemplate" TargetType="Button">
            <Border
                x:Name="Bd"
                Background="Transparent"
                BorderBrush="{DynamicResource Light.DangerBrush}"
                BorderThickness="1"
                CornerRadius="8">
                <ContentPresenter HorizontalAlignment="Center" VerticalAlignment="Center" />
            </Border>
            <ControlTemplate.Triggers>
                <Trigger Property="IsMouseOver" Value="True">
                    <Setter TargetName="Bd" Property="Background" Value="{DynamicResource Light.DangerMutedBrush}" />
                </Trigger>
                <Trigger Property="IsPressed" Value="True">
                    <Setter TargetName="Bd" Property="Background" Value="{DynamicResource Light.DangerBrush}" />
                </Trigger>
            </ControlTemplate.Triggers>
        </ControlTemplate>

    </Window.Resources>

    <Grid Background="Transparent">
        <Grid>
            <Grid.Triggers>
                <EventTrigger RoutedEvent="UIElement.MouseEnter">
                    <BeginStoryboard>
                        <Storyboard>
                            <DoubleAnimation
                                Storyboard.TargetName="WindowControls"
                                Storyboard.TargetProperty="Opacity"
                                To="1"
                                Duration="0:0:0.15" />
                        </Storyboard>
                    </BeginStoryboard>
                </EventTrigger>
                <EventTrigger RoutedEvent="UIElement.MouseLeave">
                    <BeginStoryboard>
                        <Storyboard>
                            <DoubleAnimation
                                Storyboard.TargetName="WindowControls"
                                Storyboard.TargetProperty="Opacity"
                                To="0"
                                Duration="0:0:0.25" />
                        </Storyboard>
                    </BeginStoryboard>
                </EventTrigger>
            </Grid.Triggers>

            <Border
                Padding="24"
                Background="{DynamicResource Light.BgPrimaryBrush}"
                BorderBrush="{DynamicResource Light.BorderDefaultBrush}"
                BorderThickness="1"
                CornerRadius="20">
                <Border.Effect>
                    <DropShadowEffect
                        BlurRadius="20"
                        Opacity="0.12"
                        ShadowDepth="4"
                        Color="#000000" />
                </Border.Effect>

                <Grid>
                    <StackPanel
                        x:Name="WindowControls"
                        Margin="0,4,4,0"
                        HorizontalAlignment="Right"
                        VerticalAlignment="Top"
                        Opacity="0"
                        Orientation="Horizontal">
                        <Button
                            Width="28"
                            Height="28"
                            Click="MinimizeBtn_Click"
                            Content="─"
                            FontSize="14"
                            Template="{StaticResource MinimizeButtonTemplate}" />
                        <Button
                            Width="28"
                            Height="28"
                            Margin="2,0,0,0"
                            Click="CloseBtn_Click"
                            Content="✕"
                            FontSize="14"
                            Template="{StaticResource CloseButtonTemplate}" />
                    </StackPanel>

                    <StackPanel
                        x:Name="FormPanel"
                        Opacity="0"
                        d:Opacity="1">
                        <StackPanel.RenderTransform>
                            <TranslateTransform />
                        </StackPanel.RenderTransform>
                        <StackPanel.Triggers>
                            <EventTrigger RoutedEvent="FrameworkElement.Loaded">
                                <BeginStoryboard>
                                    <Storyboard>
                                        <DoubleAnimation
                                            Storyboard.TargetProperty="Opacity"
                                            To="1"
                                            Duration="0:0:0.4">
                                            <DoubleAnimation.EasingFunction>
                                                <CubicEase EasingMode="EaseOut" />
                                            </DoubleAnimation.EasingFunction>
                                        </DoubleAnimation>
                                        <DoubleAnimation
                                            Storyboard.TargetProperty="(UIElement.RenderTransform).(TranslateTransform.Y)"
                                            From="12"
                                            To="0"
                                            Duration="0:0:0.4">
                                            <DoubleAnimation.EasingFunction>
                                                <CubicEase EasingMode="EaseOut" />
                                            </DoubleAnimation.EasingFunction>
                                        </DoubleAnimation>
                                    </Storyboard>
                                </BeginStoryboard>
                            </EventTrigger>
                        </StackPanel.Triggers>

                        <!--  Заголовок  -->
                        <TextBlock
                            Margin="0,0,0,24"
                            HorizontalAlignment="Center"
                            FontSize="22"
                            FontWeight="SemiBold"
                            Foreground="{DynamicResource Light.TextPrimaryBrush}"
                            Text="Настройки" />

                        <!--  Блок пользователя  -->
                        <StackPanel
                            x:Name="UserInfo"
                            Margin="0,0,0,20"
                            HorizontalAlignment="Center">
                            <!--  Аватар  -->
                            <!--<local1:UserControl1
                                Width="80"
                                Height="80"
                                Margin="0,0,0,12"
                                HorizontalAlignment="Center"
                                Avatar="{Binding Avatar}" />-->
                            <!--  Аватар: фон + иконка по умолчанию + фото + рамка  -->
                            <Grid
                                Width="80"
                                Height="80"
                                HorizontalAlignment="Center">
                                <Ellipse Fill="{DynamicResource Light.BgElevatedBrush}" />
                                <!--  Без отступов: круг глифа совпадает с кружком аватара  -->
                                <Viewbox Margin="0">
                                    <Path
                                        Data="{StaticResource IconDefaultAvatar}"
                                        Fill="{DynamicResource Light.TextMutedBrush}"
                                        Stretch="Uniform" />
                                </Viewbox>
                                <Ellipse>
                                    <Ellipse.Fill>
                                        <ImageBrush ImageSource="{Binding Avatar}" Stretch="UniformToFill" />
                                    </Ellipse.Fill>
                                </Ellipse>
                                <Ellipse Stroke="{DynamicResource Light.BorderSubtleBrush}" StrokeThickness="1" />
                            </Grid>

                            <!--  Имя пользователя  -->
                            <TextBlock
                                HorizontalAlignment="Center"
                                FontSize="18"
                                FontWeight="SemiBold"
                                Foreground="{DynamicResource Light.TextPrimaryBrush}"
                                Text="{Binding Name}" />

                            <!--  Смена аватара  -->
                            <Button
                                Margin="0,8,0,0"
                                HorizontalAlignment="Center"
                                Click="ChangeAvatar_Click"
                                Cursor="Hand"
                                Template="{StaticResource GhostButtonTemplate}">
                                <TextBlock
                                    FontSize="13"
                                    FontWeight="SemiBold"
                                    Foreground="{DynamicResource Light.AccentTextBrush}"
                                    Text="Сменить аватар" />
                            </Button>
                        </StackPanel>

                        <!--  Разделитель  -->
                        <Border
                            Margin="0,0,0,20"
                            Background="{DynamicResource Light.BorderSubtleBrush}"
                            Height="1" />

                        <!--  Информационные строки  -->
                        <Border
                            Margin="0,0,0,20"
                            Background="{DynamicResource Light.BgSurfaceBrush}"
                            BorderBrush="{DynamicResource Light.BorderSubtleBrush}"
                            BorderThickness="1"
                            CornerRadius="14">
                            <StackPanel>

                                <!--  Логин  -->
                                <Grid Margin="16,14">
                                    <Grid.ColumnDefinitions>
                                        <ColumnDefinition />
                                        <ColumnDefinition Width="Auto" />
                                    </Grid.ColumnDefinitions>
                                    <StackPanel>
                                        <TextBlock
                                            FontSize="11"
                                            FontWeight="SemiBold"
                                            Foreground="{DynamicResource Light.TextMutedBrush}"
                                            Text="ЛОГИН" />
                                        <TextBlock
                                            x:Name="TBLogin"
                                            FontSize="15"
                                            Foreground="{DynamicResource Light.TextPrimaryBrush}" />
                                    </StackPanel>
                                    <Viewbox
                                        Grid.Column="1"
                                        Width="16"
                                        Height="16"
                                        VerticalAlignment="Center">
                                        <Path
                                            Data="{StaticResource IconInfo}"
                                            Fill="{DynamicResource Light.TextMutedBrush}"
                                            Stretch="Uniform" />
                                    </Viewbox>
                                </Grid>

                                <!--  Разделитель строк  -->
                                <Border
                                    Margin="16,0"
                                    Background="{DynamicResource Light.BorderSubtleBrush}"
                                    Height="1" />

                                <!--  Имя пользователя  -->
                                <Grid Margin="16,14">
                                    <StackPanel>
                                        <TextBlock
                                            FontSize="11"
                                            FontWeight="SemiBold"
                                            Foreground="{DynamicResource Light.TextMutedBrush}"
                                            Text="ИМЯ ПОЛЬЗОВАТЕЛЯ" />
                                        <TextBlock
                                            x:Name="TBUsername"
                                            FontSize="15"
                                            Foreground="{DynamicResource Light.TextPrimaryBrush}" />
                                    </StackPanel>
                                </Grid>

                            </StackPanel>
                        </Border>

                        <!--  Устройство ввода  -->
                        <Border
                            Margin="0,0,0,20"
                            Background="{DynamicResource Light.BgSurfaceBrush}"
                            BorderBrush="{DynamicResource Light.BorderSubtleBrush}"
                            BorderThickness="1"
                            CornerRadius="14"
                            Padding="16,14">
                            <Grid>
                                <Grid.RowDefinitions>
                                    <RowDefinition Height="Auto" />
                                    <RowDefinition Height="Auto" />
                                </Grid.RowDefinitions>
                                <TextBlock
                                    Margin="0,0,0,8"
                                    FontSize="11"
                                    FontWeight="SemiBold"
                                    Foreground="{DynamicResource Light.TextMutedBrush}"
                                    Text="УСТРОЙСТВО ВВОДА" />
                                <ComboBox
                                    x:Name="InputDeviceCB"
                                    Grid.Row="1"
                                    FontSize="13"
                                    Foreground="{DynamicResource Light.TextPrimaryBrush}"
                                    ItemContainerStyle="{StaticResource DeviceComboBoxItemStyle}"
                                    SelectionChanged="InputDeviceCB_SelectionChanged"
                                    Template="{StaticResource DeviceComboBoxTemplate}" />
                            </Grid>
                        </Border>

                        <!--  Оформление: переключатель тёмной темы  -->
                        <Border
                            Margin="0,0,0,20"
                            Padding="16,12"
                            Background="{DynamicResource Light.BgSurfaceBrush}"
                            BorderBrush="{DynamicResource Light.BorderSubtleBrush}"
                            BorderThickness="1"
                            CornerRadius="14">
                            <Grid>
                                <Grid.ColumnDefinitions>
                                    <ColumnDefinition />
                                    <ColumnDefinition Width="Auto" />
                                </Grid.ColumnDefinitions>
                                <StackPanel VerticalAlignment="Center">
                                    <TextBlock
                                        FontSize="11"
                                        FontWeight="SemiBold"
                                        Foreground="{DynamicResource Light.TextMutedBrush}"
                                        Text="ОФОРМЛЕНИЕ" />
                                    <TextBlock
                                        x:Name="ThemeLabel"
                                        FontSize="15"
                                        Foreground="{DynamicResource Light.TextPrimaryBrush}"
                                        Text="Светлая тема" />
                                </StackPanel>
                                <ToggleButton
                                    x:Name="ThemeToggle"
                                    Grid.Column="1"
                                    VerticalAlignment="Center"
                                    Checked="ThemeToggle_Changed"
                                    Cursor="Hand"
                                    Template="{StaticResource ToggleSwitchTemplate}"
                                    Unchecked="ThemeToggle_Changed" />
                            </Grid>
                        </Border>

                        <!--  Приложение: версия и обновления  -->
                        <Border
                            Margin="0,0,0,20"
                            Padding="16,14"
                            Background="{DynamicResource Light.BgSurfaceBrush}"
                            BorderBrush="{DynamicResource Light.BorderSubtleBrush}"
                            BorderThickness="1"
                            CornerRadius="14">
                            <Grid>
                                <Grid.ColumnDefinitions>
                                    <ColumnDefinition />
                                    <ColumnDefinition Width="Auto" />
                                </Grid.ColumnDefinitions>
                                <StackPanel VerticalAlignment="Center">
                                    <TextBlock
                                        FontSize="11"
                                        FontWeight="SemiBold"
                                        Foreground="{DynamicResource Light.TextMutedBrush}"
                                        Text="ПРИЛОЖЕНИЕ" />
                                    <TextBlock
                                        x:Name="TBVersion"
                                        FontSize="15"
                                        Foreground="{DynamicResource Light.TextPrimaryBrush}" />
                                    <!--  Переключатель сервера: туннель DrunkMan ↔ Adress.txt (авто)  -->
                                    <TextBlock
                                        Margin="0,10,0,0"
                                        FontSize="11"
                                        FontWeight="SemiBold"
                                        Foreground="{DynamicResource Light.TextMutedBrush}"
                                        Text="СЕРВЕР" />
                                    <StackPanel Orientation="Horizontal">
                                        <TextBlock
                                            x:Name="TBServerChoice"
                                            VerticalAlignment="Center"
                                            FontSize="15"
                                            Foreground="{DynamicResource Light.TextPrimaryBrush}"
                                            Text="Adress.txt (авто)" />
                                        <Button
                                            Margin="10,0,0,0"
                                            VerticalAlignment="Center"
                                            Click="ToggleServer_Click"
                                            Cursor="Hand"
                                            Template="{StaticResource GhostButtonTemplate}"
                                            ToolTip="Переключить сервер. Уже открытые соединения переподключатся сами; надёжнее — перезапустить приложение.">
                                            <TextBlock
                                                FontSize="13"
                                                FontWeight="SemiBold"
                                                Foreground="{DynamicResource Light.AccentTextBrush}"
                                                Text="Переключить" />
                                        </Button>
                                    </StackPanel>
                                </StackPanel>
                                <Button
                                    Grid.Column="1"
                                    VerticalAlignment="Center"
                                    Click="CheckUpdates_Click"
                                    Cursor="Hand"
                                    Template="{StaticResource GhostButtonTemplate}">
                                    <TextBlock
                                        FontSize="13"
                                        FontWeight="SemiBold"
                                        Foreground="{DynamicResource Light.AccentTextBrush}"
                                        Text="Проверить обновления" />
                                </Button>
                            </Grid>
                        </Border>

                        <!--  Кнопка выйти  -->
                        <Button
                            Height="40"
                            Click="Button_Exit_Click"
                            Template="{StaticResource DangerButtonTemplate}">
                            <StackPanel Orientation="Horizontal">
                                <TextBlock
                                    Margin="0,0,8,0"
                                    FontSize="16"
                                    Foreground="{DynamicResource Light.DangerBrush}"
                                    Text="⏻" />
                                <TextBlock
                                    VerticalAlignment="Center"
                                    FontSize="14"
                                    FontWeight="SemiBold"
                                    Foreground="{DynamicResource Light.DangerBrush}"
                                    Text="Выйти из аккаунта" />
                            </StackPanel>
                        </Button>

                    </StackPanel>
                </Grid>
            </Border>
        </Grid>
    </Grid>
</Window>
