<Window
    x:Class="Tebegrammmm.AvatarCropWindow"
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
    xmlns:classes="clr-namespace:Tebegrammmm.Classes"
    xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
    xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
    Title="Аватар"
    Width="{x:Static classes:UiSizes.DialogWidth}"
    SizeToContent="Height"
    AllowsTransparency="True"
    Background="Transparent"
    MouseDown="Window_MouseDown"
    WindowStartupLocation="CenterScreen"
    WindowStyle="None"
    mc:Ignorable="d">

    <Window.Resources>
        <ControlTemplate x:Key="PrimaryButtonTemplate" TargetType="Button">
            <Border x:Name="Bd" Background="{TemplateBinding Background}" CornerRadius="8">
                <ContentPresenter HorizontalAlignment="Center" VerticalAlignment="Center" />
            </Border>
            <ControlTemplate.Triggers>
                <Trigger Property="IsMouseOver" Value="True">
                    <Setter TargetName="Bd" Property="Background" Value="{DynamicResource Light.AccentHoverBrush}" />
                </Trigger>
                <Trigger Property="IsPressed" Value="True">
                    <Setter TargetName="Bd" Property="Background" Value="{DynamicResource Light.AccentPressedBrush}" />
                </Trigger>
            </ControlTemplate.Triggers>
        </ControlTemplate>
        <ControlTemplate x:Key="SecondaryButtonTemplate" TargetType="Button">
            <Border
                x:Name="Bd"
                Background="Transparent"
                BorderBrush="{TemplateBinding BorderBrush}"
                BorderThickness="{TemplateBinding BorderThickness}"
                CornerRadius="8">
                <ContentPresenter HorizontalAlignment="Center" VerticalAlignment="Center" />
            </Border>
            <ControlTemplate.Triggers>
                <Trigger Property="IsMouseOver" Value="True">
                    <Setter TargetName="Bd" Property="Background" Value="{DynamicResource Light.BgElevatedBrush}" />
                </Trigger>
            </ControlTemplate.Triggers>
        </ControlTemplate>
    </Window.Resources>

    <Border
        Padding="24"
        Background="{DynamicResource Light.BgPrimaryBrush}"
        BorderBrush="{DynamicResource Light.BorderDefaultBrush}"
        BorderThickness="1"
        CornerRadius="20">
        <Border.Effect>
            <DropShadowEffect
                BlurRadius="20"
                Opacity="0.14"
                ShadowDepth="4"
                Color="#000000" />
        </Border.Effect>

        <StackPanel>
            <TextBlock
                Margin="0,0,0,4"
                HorizontalAlignment="Center"
                FontSize="20"
                FontWeight="SemiBold"
                Foreground="{DynamicResource Light.TextPrimaryBrush}"
                Text="Новый аватар" />
            <TextBlock
                Margin="0,0,0,18"
                HorizontalAlignment="Center"
                FontSize="13"
                Foreground="{DynamicResource Light.TextMutedBrush}"
                Text="Перетащите фото и настройте масштаб" />

            <!--  Область обрезки: круглый предпросмотр  -->
            <Border
                Width="300"
                Height="300"
                HorizontalAlignment="Center"
                CornerRadius="16"
                ClipToBounds="True">
                <Grid
                    x:Name="CropArea"
                    Width="300"
                    Height="300"
                    Background="{DynamicResource Light.BgDeepBrush}"
                    ClipToBounds="True"
                    Cursor="SizeAll"
                    MouseLeftButtonDown="CropArea_MouseLeftButtonDown"
                    MouseLeftButtonUp="CropArea_MouseLeftButtonUp"
                    MouseMove="CropArea_MouseMove"
                    MouseWheel="CropArea_MouseWheel">
                    <Image
                        x:Name="CropImage"
                        RenderTransformOrigin="0.5,0.5"
                        Stretch="UniformToFill">
                        <Image.RenderTransform>
                            <TransformGroup>
                                <ScaleTransform x:Name="ImgScale" ScaleX="1" ScaleY="1" />
                                <TranslateTransform x:Name="ImgTranslate" X="0" Y="0" />
                            </TransformGroup>
                        </Image.RenderTransform>
                    </Image>
                    <!--  Затемнение вне круга  -->
                    <Path x:Name="MaskOverlay" Fill="#88000000" IsHitTestVisible="False">
                        <Path.Data>
                            <CombinedGeometry GeometryCombineMode="Exclude">
                                <CombinedGeometry.Geometry1>
                                    <RectangleGeometry Rect="0,0,300,300" />
                                </CombinedGeometry.Geometry1>
                                <CombinedGeometry.Geometry2>
                                    <EllipseGeometry
                                        Center="150,150"
                                        RadiusX="149"
                                        RadiusY="149" />
                                </CombinedGeometry.Geometry2>
                            </CombinedGeometry>
                        </Path.Data>
                    </Path>
                    <Ellipse
                        x:Name="RingOverlay"
                        Width="298"
                        Height="298"
                        IsHitTestVisible="False"
                        Stroke="White"
                        StrokeThickness="2" />
                </Grid>
            </Border>

            <!--  Ползунок масштаба  -->
            <Grid Margin="0,16,0,20">
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="Auto" />
                    <ColumnDefinition />
                    <ColumnDefinition Width="Auto" />
                </Grid.ColumnDefinitions>
                <TextBlock
                    VerticalAlignment="Center"
                    FontSize="16"
                    Foreground="{DynamicResource Light.TextMutedBrush}"
                    Text="−" />
                <Slider
                    x:Name="ZoomSlider"
                    Grid.Column="1"
                    Margin="10,0"
                    VerticalAlignment="Center"
                    Maximum="4"
                    Minimum="1"
                    Value="1"
                    ValueChanged="ZoomSlider_ValueChanged" />
                <TextBlock
                    Grid.Column="2"
                    VerticalAlignment="Center"
                    FontSize="18"
                    Foreground="{DynamicResource Light.TextMutedBrush}"
                    Text="+" />
            </Grid>

            <!--  Кнопки  -->
            <Grid>
                <Grid.ColumnDefinitions>
                    <ColumnDefinition />
                    <ColumnDefinition Width="12" />
                    <ColumnDefinition />
                </Grid.ColumnDefinitions>
                <Button
                    Grid.Column="0"
                    Height="40"
                    BorderBrush="{DynamicResource Light.BorderDefaultBrush}"
                    BorderThickness="1"
                    Click="Cancel_Click"
                    Content="Отмена"
                    FontSize="14"
                    Foreground="{DynamicResource Light.TextSecondaryBrush}"
                    Template="{StaticResource SecondaryButtonTemplate}" />
                <Button
                    Grid.Column="2"
                    Height="40"
                    Background="{DynamicResource Light.AccentPrimaryBrush}"
                    Click="Apply_Click"
                    Content="Поставить"
                    FontSize="14"
                    FontWeight="SemiBold"
                    Foreground="White"
                    Template="{StaticResource PrimaryButtonTemplate}" />
            </Grid>
        </StackPanel>
    </Border>
</Window>
