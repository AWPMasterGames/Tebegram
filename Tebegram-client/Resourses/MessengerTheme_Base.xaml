<ResourceDictionary xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation" xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml">
    <!--
        Радиальный градиент: центр чуть выше середины, немного светлее - 
        создаёт ощущение глубины и «источника света сверху».
        Так делают Telegram и большинство тёмных мессенджеров.
    -->
    <RadialGradientBrush x:Key="ChatBackground" Center="0.5,0.2" GradientOrigin="0.5,0.2" RadiusX="1.1" RadiusY="0.95">
        <GradientStop Offset="0.0" Color="#1E2845" />
        <GradientStop Offset="1.0" Color="#0D1117" />
    </RadialGradientBrush>

    <!--  Светлая тема: очень тихий тёплый градиент, как в Telegram Light  -->
    <LinearGradientBrush x:Key="ChatBackgroundLight" StartPoint="0,0" EndPoint="1,1">
        <GradientStop Offset="0.0" Color="#F0F4FF" />
        <GradientStop Offset="1.0" Color="#EAECF5" />
    </LinearGradientBrush>

    <!--  Тонкий узор-обои области сообщений: сетка едва заметных точек.
          Полупрозрачный нейтральный цвет одинаково деликатно ложится и на светлую,
          и на тёмную тему (кладётся поверх сплошного фона темы).  -->
    <DrawingBrush
        x:Key="ChatPatternBrush"
        Stretch="None"
        TileMode="Tile"
        Viewport="0,0,26,26"
        ViewportUnits="Absolute">
        <DrawingBrush.Drawing>
            <!--  Цвет точек берётся из темы (Light.ChatDotBrush): на светлой теме он
                  темнее и точки видно, на тёмной - прежний деликатный. Задаётся в
                  ThemeManager и меняется вживую при переключении темы  -->
            <GeometryDrawing Brush="{DynamicResource Light.ChatDotBrush}">
                <GeometryDrawing.Geometry>
                    <EllipseGeometry
                        Center="13,13"
                        RadiusX="1.3"
                        RadiusY="1.3" />
                </GeometryDrawing.Geometry>
            </GeometryDrawing>
        </DrawingBrush.Drawing>
    </DrawingBrush>
</ResourceDictionary>