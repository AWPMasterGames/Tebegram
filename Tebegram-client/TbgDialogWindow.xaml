<Window
    x:Class="Tebegrammmm.TbgDialogWindow"
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
    xmlns:classes="clr-namespace:Tebegrammmm.Classes"
    xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
    xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
    Title="Tebegram"
    Width="{x:Static classes:UiSizes.DialogWidth}"
    AllowsTransparency="True"
    Background="Transparent"
    MouseDown="Window_MouseDown"
    ResizeMode="NoResize"
    ShowInTaskbar="False"
    SizeToContent="Height"
    WindowStartupLocation="CenterScreen"
    WindowStyle="None"
    mc:Ignorable="d">

    <Window.Resources>
        <ControlTemplate x:Key="PrimaryButtonTemplate" TargetType="Button">
            <Border x:Name="Bd" Background="{TemplateBinding Background}" CornerRadius="8">
                <ContentPresenter HorizontalAlignment="Center" VerticalAlignment="Center" />
            </Border>
            <ControlTemplate.Triggers>
                <Trigger Property="IsMouseOver" Value="True">
                    <Setter TargetName="Bd" Property="Background" Value="{DynamicResource Light.AccentHoverBrush}" />
                </Trigger>
                <Trigger Property="IsPressed" Value="True">
                    <Setter TargetName="Bd" Property="Background" Value="{DynamicResource Light.AccentPressedBrush}" />
                </Trigger>
            </ControlTemplate.Triggers>
        </ControlTemplate>

        <ControlTemplate x:Key="SecondaryButtonTemplate" TargetType="Button">
            <Border
                x:Name="Bd"
                Background="Transparent"
                BorderBrush="{TemplateBinding BorderBrush}"
                BorderThickness="{TemplateBinding BorderThickness}"
                CornerRadius="8">
                <ContentPresenter HorizontalAlignment="Center" VerticalAlignment="Center" />
            </Border>
            <ControlTemplate.Triggers>
                <Trigger Property="IsMouseOver" Value="True">
                    <Setter TargetName="Bd" Property="Background" Value="{DynamicResource Light.BgElevatedBrush}" />
                </Trigger>
                <Trigger Property="IsPressed" Value="True">
                    <Setter TargetName="Bd" Property="Background" Value="{DynamicResource Light.BgDeepBrush}" />
                </Trigger>
            </ControlTemplate.Triggers>
        </ControlTemplate>
    </Window.Resources>

    <Border
        Margin="10"
        Padding="24,20"
        Background="{DynamicResource Light.BgPrimaryBrush}"
        BorderBrush="{DynamicResource Light.BorderDefaultBrush}"
        BorderThickness="1"
        CornerRadius="16">
        <Border.Effect>
            <DropShadowEffect
                BlurRadius="20"
                Opacity="0.14"
                ShadowDepth="4"
                Color="#000000" />
        </Border.Effect>

        <StackPanel>
            <TextBlock
                x:Name="TitleText"
                Margin="0,0,0,10"
                FontSize="17"
                FontWeight="SemiBold"
                Foreground="{DynamicResource Light.TextPrimaryBrush}"
                Text="Заголовок"
                TextWrapping="Wrap" />

            <TextBlock
                x:Name="MessageText"
                Margin="0,0,0,20"
                FontSize="14"
                Foreground="{DynamicResource Light.TextSecondaryBrush}"
                Text="Сообщение"
                TextWrapping="Wrap" />

            <Grid>
                <Grid.ColumnDefinitions>
                    <ColumnDefinition />
                    <ColumnDefinition />
                </Grid.ColumnDefinitions>

                <Button
                    x:Name="SecondaryBtn"
                    Height="36"
                    Margin="0,0,6,0"
                    BorderBrush="{DynamicResource Light.BorderDefaultBrush}"
                    BorderThickness="1"
                    Click="SecondaryBtn_Click"
                    Content="Нет"
                    FontSize="14"
                    Foreground="{DynamicResource Light.TextSecondaryBrush}"
                    IsCancel="True"
                    Template="{StaticResource SecondaryButtonTemplate}" />

                <Button
                    x:Name="PrimaryBtn"
                    Grid.Column="1"
                    Height="36"
                    Margin="6,0,0,0"
                    Background="{DynamicResource Light.AccentPrimaryBrush}"
                    Click="PrimaryBtn_Click"
                    Content="ОК"
                    FontSize="14"
                    FontWeight="SemiBold"
                    Foreground="{DynamicResource Light.TextInverseBrush}"
                    IsDefault="True"
                    Template="{StaticResource PrimaryButtonTemplate}" />
            </Grid>
        </StackPanel>
    </Border>
</Window>
