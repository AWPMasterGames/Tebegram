<UserControl
    x:Class="Tebegrammmm.Controls.UserControl1"
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
    xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
    xmlns:local="clr-namespace:Tebegrammmm.Controls"
    xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
    x:Name="Root"
    Width="40"
    Height="40"
    d:DesignHeight="40"
    d:DesignWidth="40"
    mc:Ignorable="d">

    <Grid>
        <!--  Фоновый круг  -->
        <Ellipse Fill="{DynamicResource Light.BgElevatedBrush}" />

        <!--  Иконка по умолчанию (видна, пока нет фото); без отступов - на весь круг  -->
        <Viewbox Margin="0">
            <Path
                Data="{StaticResource IconDefaultAvatar}"
                Fill="{DynamicResource Light.TextMutedBrush}"
                Stretch="Uniform" />
        </Viewbox>

        <!--  Фото аватара: заполняет ВЕСЬ круг (UniformToFill + без отступов).
              Привязка стоит на Ellipse.Fill, а не внутри ImageBrush: ElementName
              внутри Freezable не резолвится (ошибка «не удается найти управляющий
              FrameworkElement»), поэтому кисть собирает конвертер  -->
        <Ellipse Fill="{Binding Avatar, ElementName=Root, Converter={StaticResource ImageToBrush}}" />

        <!--  Тонкая граница  -->
        <Ellipse Stroke="{DynamicResource Light.BorderSubtleBrush}" StrokeThickness="1" />
    </Grid>
</UserControl>
